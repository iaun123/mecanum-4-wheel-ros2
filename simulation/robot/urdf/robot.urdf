<?xml version="1.0" encoding="utf-8"?>
<robot name="pro" xmlns:xacro="http://ros.org/wiki/xacro">

<!-- color -->
  <material name="black">
    <color rgba="0.2 0.2 0.2 1" />
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0" />
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="white">
    <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
  </material>
  <material name="red">
    <color rgba="1 0 0 1" />
  </material>

<!-- base link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.00110722546972766 -0.000881363789764601 0.000896456868487516" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia
        ixx="0.000515892591088768"
        ixy="3.51265993938339E-06"
        ixz="-1.07236227973216E-07"
        iyy="0.000989448211818998"
        iyz="-1.2825575037116E-07"
        izz="0.00142165209596468" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/base_link.STL" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>

<!-- base_footprint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
  </joint>

<!-- lf -->
  <link name="left_front_link">
    <inertial>
      <origin xyz="0.000194225316144145 -0.000828209013987113 0.000986492502320621" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia
        ixx="6.60491736740839E-05"
        ixy="5.65423279156466E-08"
        ixz="-2.15031963946931E-07"
        iyy="6.58573686281087E-05"
        iyz="-5.88454152671157E-08"
        izz="9.9502807224037E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/left_front_link.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/left_front_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_front_joint" type="continuous">
    <origin xyz="0.074805 0.095021 -0.016504" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="left_front_link" />
    <axis xyz="0 0 -1" />
  </joint>

  <gazebo reference="left_front_link">
    <material>Gazebo/Black</material>
  </gazebo>

<!-- rf -->
  <link name="right_front_link">
    <inertial>
      <origin xyz="0.000792045383486775 -0.000327398755852741 -0.00097139380563907" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia
        ixx="6.58754749146013E-05"
        ixy="7.86279996081456E-08"
        ixz="8.49550351004516E-08"
        iyy="6.60326041337809E-05"
        iyz="2.06255946908732E-07"
        izz="9.95032142784321E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/right_front_link.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/right_front_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_front_joint" type="continuous">
    <origin xyz="0.074805 -0.094979 -0.016504" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="right_front_link" />
    <axis xyz="0 0 1" />
  </joint>

  <gazebo reference="right_front_link">
    <material>Gazebo/Black</material>
  </gazebo>

<!-- rb -->
  <link name="right_back_link">
    <inertial>
      <origin xyz="-0.000773470199692303 -0.000353801232542403 -0.000986487989111592" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia
        ixx="6.5874517458556E-05"
        ixy="-7.88341300118085E-08"
        ixz="-8.51211993149177E-08"
        iyy="6.60315992760322E-05"
        iyz="2.05846020987768E-07"
        izz="9.95023481099526E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/right_back_link.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/right_back_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_back_joint" type="continuous">
    <origin xyz="-0.075684 -0.094979 -0.016504" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="right_back_link" />
    <axis xyz="0 0 1" />
  </joint>

  <gazebo reference="right_back_link">
    <material>Gazebo/Black</material>
  </gazebo>

<!-- lb -->
  <link name="left_back_link">
    <inertial>
      <origin xyz="-0.000792048600706974 -0.000327401208942674 0.000971393876159951" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia
        ixx="6.58754747457331E-05"
        ixy="-7.86281708586474E-08"
        ixz="8.49525974156277E-08"
        iyy="6.60326034401508E-05"
        iyz="-2.06258052484318E-07"
        izz="9.95032135393818E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/left_back_link.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/left_back_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_back_joint" type="continuous">
    <origin xyz="-0.075684 0.095021 -0.016504" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="left_back_link" />
    <axis xyz="0 0 -1" />
  </joint>

  <gazebo reference="left_back_link">
    <material>Gazebo/Black</material>
  </gazebo>

<!-- cam  -->
  <link name="camera_link">
    <inertial>
      <origin xyz="-0.000367790326270767 0.00323906965269144 -5.30738632309041E-05" rpy="0 0 0" />
      <mass value="0.040528016503577" />
      <inertia
        ixx="4.05785979538911E-05"
        ixy="3.56539280580418E-07"
        ixz="4.66370532236397E-08"
        iyy="3.49041875072854E-06"
        iyz="3.88944445461142E-07"
        izz="3.74941507176843E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/camera_link.STL" />
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/camera_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.11646 1.7971E-05 0.058" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="camera_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="camera_rgb_frame"/>
  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>20.0</update_rate>
      <topic>camera</topic>
      <gz_frame_id>camera_rgb_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

<!-- rp -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="8.38413796889446E-05 -9.42035183245905E-05 -0.0165835731091839" rpy="0 0 0" />
      <mass value="0.032404615890783" />
      <inertia
        ixx="1.08405105236319E-05"
        ixy="-2.3933156084419E-09"
        ixz="1.61833884660667E-08"
        iyy="1.07831255822121E-05"
        iyz="-4.19844857280673E-09"
        izz="1.96305335345869E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/lidar_link.STL" />
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/lidar_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.024561 2.068E-05 0.080078" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

<!-- imu -->
  <link name="imu_link">
    <inertial>
      <origin xyz="-0.00165537333783889 0.000107786090904231 -0.000448013789479707" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia
        ixx="1.33292005146446E-08"
        ixy="5.60536119209215E-12"
        ixz="-6.25784169122668E-14"
        iyy="7.56085417916531E-09"
        iyz="2.9897203630263E-17"
        izz="1.99747898140485E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/imu_link.STL" />
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot/meshes/imu_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.00043943 2.068E-05 0.0020715" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
    <axis xyz="0 0 0" />
  </joint>

  <gazebo reference="imu_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Gazebo Physics & Friction Properties (low friction to allow smooth 8-direction omnidirectional gliding) -->
  <gazebo reference="base_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="left_front_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="right_front_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="left_back_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="right_back_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- Gazebo Harmonic System Plugins -->
  <gazebo>
    <!-- Joint State Publisher Plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_front_joint</joint_name>
      <joint_name>right_front_joint</joint_name>
      <joint_name>left_back_joint</joint_name>
      <joint_name>right_back_joint</joint_name>
    </plugin>

    <!-- Omnidirectional Holonomic Velocity Controller (8-Direction Movement) -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>cmd_vel</topic>
      <link_name>base_footprint</link_name>
    </plugin>

    <!-- Odometry Publisher for 8-Direction Holonomic Motion -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Sensors Plugin -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU Plugin -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>
  </gazebo>

</robot>